    "@tailwindcss/vite": "4.1.16",
    "commitlint-config-gitmoji": "2.3.1",
    "lefthook": "2.0.2",
    "svelte": "5.43.4",
    "svelte-check": "4.3.3",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "vite": "7.2.1"
